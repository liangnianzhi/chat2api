# Chat2API 网关 —— 环境变量模板
# 复制为 .env 后按需修改：  cp .env.example .env
#
# 设计原则：这里只放"启动容器必须知道"的东西。
# 账号、提供商、客户端密钥、负载均衡、日志级别等全部在 Web 管理台里配置。
#       管理台地址：http://<主机IP>:8081

# ---------------------------------------------------------------------------
# 上游版本
# ---------------------------------------------------------------------------
# main = 跟随上游最新提交（重建即可升级）
# 也可锁定 release，例如 v1.7.16
CHAT2API_REF=main

# ---------------------------------------------------------------------------
# 端口
# ---------------------------------------------------------------------------
# OpenAI 兼容 API 端口
CHAT2API_PORT=8080
# Web 管理台端口
CHAT2API_UI_PORT=8081
# 绑定地址：0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机
CHAT2API_BIND=0.0.0.0
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 管理台登录密钥（必填）
# ---------------------------------------------------------------------------
# 这是打开管理台时要填的密码，同时也是管理 API 的 Bearer token。
# 生成：  ./manage.sh keygen
CHAT2API_MANAGEMENT_SECRET=

# ---------------------------------------------------------------------------
# 可选：客户端 API 密钥
# ---------------------------------------------------------------------------
# 留空即可 —— 推荐启动后到管理台「客户端 API 密钥」页生成，
# 那样无需重启容器，也能随时吊销。
# CHAT2API_API_KEY=
# CHAT2API_ENABLE_API_KEY=false

# ---------------------------------------------------------------------------
# 可选：默认行为（都能在管理台里改，此处留空即可）
# ---------------------------------------------------------------------------
# CHAT2API_LOG_LEVEL=info
# CHAT2API_LB_STRATEGY=round-robin
# CHAT2API_REQUEST_TIMEOUT=60000
# CHAT2API_RETRY_COUNT=3
# CHAT2API_ENABLE_CORS=true
# CHAT2API_CORS_ORIGIN=*

# 关闭 Web 管理台（例如你只用管理 API）
# CHAT2API_ENABLE_WEBUI=false

# 出站代理（Perplexity 适配器的 net shim 会用到）
# HTTPS_PROXY=http://127.0.0.1:7890
